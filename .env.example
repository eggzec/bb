# Bitbucket Cloud credentials — copy to .env and fill in your values.
# .env is gitignored; never commit it.

# --- Required: API Token auth (recommended) ---
# Your Atlassian account email address.
BB_EMAIL=you@example.com
# API token from https://id.atlassian.com/manage-profile/security/api-tokens
BB_TOKEN=ATATT3xFfGF0...

# --- Required: workspace context ---
# Workspace slug from https://bitbucket.org/<BB_WORKSPACE>/
BB_WORKSPACE=my-workspace-slug

# --- Optional: probe repo for 200-response schema coverage ---
# Run `make schema-discover-cloud` to find the best value for your workspace.
# If unset, schemathesis uses random slugs (404s) and the live tests fall back to
# the first repo returned by repos.list — set this when you have a known good repo.
BB_REPO_SLUG=my-probe-repo

# --- Optional: probe project key (uppercase) ---
# Run `make schema-discover-cloud` to find a suitable value.
# BB_PROJECT_KEY=PROJ

# --- Optional: code search query known to match something in your workspace ---
# BB_SEARCH_QUERY=def

# --- Alternative: OAuth 2.0 client credentials (server-to-server) ---
# BB_OAUTH_CLIENT_ID=Abcd1234...
# BB_OAUTH_CLIENT_SECRET=ZzZz...

# --- Alternative: already-obtained OAuth 2.0 Bearer token ---
# BB_OAUTH_TOKEN=eyJhbGc...
# BB_OAUTH_EXPIRES=3600
# BB_OAUTH_REFRESH=...

# --- Bitbucket Data Center (local instance) ---
# Point these at your running Bitbucket DC instance (docker-compose, docker run, or self-hosted).
# Required for schema-test-dc and live tests (tests/datacenter/live/).

# Base URL of the DC REST API — no trailing slash
BB_DC_BASE_URL=http://localhost:7990/rest

# Personal access token for SDK authentication (Bearer token)
# Create via: curl -su admin:<password> -X POST http://localhost:7990/rest/access-tokens/1.0/me \
#   -H 'Content-Type: application/json' \
#   -d '{"name":"test-token","permissions":["PROJECT_ADMIN","REPO_ADMIN"]}'
BB_DC_TOKEN=<personal-access-token>

# Admin password for schemathesis Basic auth (used by schema-test-dc target)
BB_DC_ADMIN_PASSWORD=<admin-password>

# Set these after running: make schema-discover-dc
# Project key and repo slug — used by live tests (tests/datacenter/live/)
# BB_DC_PROJECT_KEY=TEST
# BB_DC_REPO_SLUG=test-repo
